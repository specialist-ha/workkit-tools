{
  "crons": [{ "path": "/api/cleanup", "schedule": "10 18 * * *" }],
  "headers": [
    { "source": "/downloads/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
